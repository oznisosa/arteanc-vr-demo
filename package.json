{
  "name": "arteanc-vr",
  "private": true,
  "version": "0.1.0",
  "description": "Tienda-museo virtual de ArteAnc para Meta Quest 3 y escritorio (A-Frame + WebXR)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "quest": "vite --mode quest",
    "salas": "node herramientas/generar-salas.js",
    "validar": "node herramientas/validar-catalogo.js && node herramientas/validar-salas.js",
    "probar": "node --test \"pruebas/*.test.js\"",
    "build": "npm run validar && npm run probar && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "vite": "^8.3.6"
  }
}
